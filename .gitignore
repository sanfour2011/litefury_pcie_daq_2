# Vivado generated/temporary files
*.jou
*.log
*.str
.Xil/
*.cache/
*.hw/
*.ip_user_files/
*.runs/
*.sim/
*.gen/
*.xpr.lock
*.dcp

# Block Design: keep only the .bd source file, everything else is generated
*.srcs/sources_1/bd/**
!*.srcs/sources_1/bd/**/
!*.srcs/sources_1/bd/**/*.bd

# Keep project file, constraints, sources, and testbenches
!*.xpr
!*.srcs/constrs_1/**
!*.srcs/sources_1/new/**
!*.srcs/sim_1/**

# Packaged IP: keep the full source folder (do not include generated clutter)
!ip_repo/**
ip_repo/edit_*/
ip_repo/*.jou
ip_repo/*.log
ip_repo/*.str
ip_repo/.Xil/

# Old experimental Vivado test projects, not part of the repo
litefury_pcie_daq_2.tmp/

# DFX bookkeeping file, currently not used
dfx_runtime.txt

# Ignore VS Code-specific files
vhdl-linter.yml
vhdl_ls.toml
new.code-workspace